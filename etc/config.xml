<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
	<default>
		<payment>
			<tuna>
				<title>Tuna</title>
				<active>0</active>
				<model>Tuna\TunaGateway\Model\Payment\Tuna</model>
				<order_status>tuna_Started</order_status>
				<log_file>var/log/tuna.log</log_file>
			</tuna>
			<credit>
				<title>Cartão de crédito</title>
				<active>1</active>
				<model>Tuna\TunaGateway\Model\Payment\Credit</model>
				<order_status>tuna_Started</order_status>
				<log_file>var/log/tuna.log</log_file>
			</credit>			
			<boleto>
				<title>Boleto</title>
				<active>1</active>
				<model>Tuna\TunaGateway\Model\Payment\Boleto</model>
				<order_status>tuna_Started</order_status>
				<log_file>var/log/tuna.log</log_file>
			</boleto>
			<crypto>
				<title>Crypto</title>
				<active>1</active>
				<model>Tuna\TunaGateway\Model\Payment\Crypto</model>
				<order_status>tuna_Started</order_status>
				<log_file>var/log/tuna.log</log_file>
			</crypto>
			<link>
				<title>Link</title>
				<active>1</active>
				<model>Tuna\TunaGateway\Model\Payment\Link</model>
				<order_status>tuna_Started</order_status>
				<log_file>var/log/tuna.log</log_file>
			</link>
			<googlepay>
				<title>Google Pay</title>
				<active>1</active>
				<model>Tuna\TunaGateway\Model\Payment\GooglePay</model>
				<order_status>tuna_Started</order_status>
				<log_file>var/log/tuna.log</log_file>
			</googlepay>
			<applepay>
				<title>Apple Pay</title>
				<active>1</active>
				<model>Tuna\TunaGateway\Model\Payment\ApplePay</model>
				<order_status>tuna_Started</order_status>
				<log_file>var/log/tuna.log</log_file>
			</applepay>
			<pix>
				<title>PIX</title>
				<active>1</active>
				<model>Tuna\TunaGateway\Model\Payment\Pix</model>
				<order_status>tuna_Started</order_status>
				<log_file>var/log/tuna.log</log_file>
			</pix>
			<tuna_payment>
				<options>
					<use_custom_status>1</use_custom_status>
					<enable_debug_logging>0</enable_debug_logging>
				</options>
			</tuna_payment>
		</payment>
	</default>
</config>